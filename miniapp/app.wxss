/* Global base */
page {
  background: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
}

view,
text,
image,
button,
input,
scroll-view {
  box-sizing: border-box;
}

.theme-light {
  --bg: #f7f7f5;
  --surface: #ffffff;
  --text: #191919;
  --text2: #6b6b6b;
  --divider: #ececea;
  --border: #e6e6e3;
  --primary: #2f80ed;
  --danger: #e5484d;
  --press: rgba(0, 0, 0, 0.035);
}

.theme-dark {
  --bg: #0f0f0f;
  --surface: #171717;
  --text: #ededed;
  --text2: #a3a3a3;
  --divider: #242424;
  --border: #2a2a2a;
  --primary: #60a5fa;
  --danger: #fb7185;
  --press: rgba(255, 255, 255, 0.07);
}

.page {
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
}

.container {
  padding: 8px 16px 24px;
}

.surface {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 16px;
}

.sheet {
  background: var(--surface);
  border-bottom: 1px solid var(--divider);
}

.sheet__inner {
  padding: 14px 16px;
}

.sheet__inner--tight {
  padding: 12px 16px;
}

.center {
  text-align: center;
}

.divider {
  height: 1px;
  background: var(--divider);
}

.h1 {
  font-size: 18px;
  line-height: 24px;
  font-weight: 600;
}

.title {
  font-size: 16px;
  line-height: 22px;
  font-weight: 500;
}

.body {
  font-size: 14px;
  line-height: 20px;
  font-weight: 400;
}

.meta {
  font-size: 12px;
  line-height: 16px;
  font-weight: 400;
  color: var(--text2);
}

.line1 {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.line2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.line3 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.btn {
  height: 44px;
  border-radius: 12px;
  padding: 0 14px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  line-height: 20px;
  font-weight: 500;
}

.btn--primary {
  background: var(--primary);
  color: #ffffff;
}

.btn--ghost {
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text);
}

.btn--danger {
  background: transparent;
  border: 1px solid var(--danger);
  color: var(--danger);
}

.btn--muted {
  background: transparent;
  border: 1px solid var(--divider);
  color: var(--text2);
}

.pressable {
  transition: background-color 0.1s ease;
}

.pressable:active {
  background: var(--press);
}

/* Chips */
.chip-row {
  display: flex;
  flex-direction: row;
  gap: 8px;
}

.chip {
  height: 30px;
  padding: 0 12px;
  border-radius: 999px;
  border: 1px solid var(--border);
  color: var(--text2);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  line-height: 18px;
}

.chip--selected {
  background: rgba(47, 128, 237, 0.12);
  border-color: rgba(47, 128, 237, 0.2);
  color: var(--primary);
}

.theme-dark .chip--selected {
  background: rgba(96, 165, 250, 0.14);
  border-color: rgba(96, 165, 250, 0.24);
}

/* List items */
.list {
  overflow: hidden;
}

.list-item {
  padding: 18px 16px;
  background: var(--surface);
}

.list-item + .list-item {
  border-top: 1px solid var(--divider);
}

/* Bottom fixed CTA */
.bottom-cta {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
  background: var(--surface);
  border-top: 1px solid var(--divider);
}

.bottom-cta__inner {
  width: 100%;
}
