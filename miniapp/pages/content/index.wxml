<view class="page {{themeClass}}">
  <topbar title="详情" nav="{{nav}}" showBack="{{true}}"></topbar>

  <view class="sheet">
    <view wx:if="{{!content}}" class="sheet__inner">
      <view class="meta">内容不存在或已被删除。</view>
    </view>

    <view wx:else>
      <view class="sheet__inner">
        <view class="h1 line3">{{content.title}}</view>
        <view style="height: 10px;"></view>
        <view class="meta line1">{{content.source_name}} · {{content.published_ago}}</view>
      </view>

      <view class="divider"></view>

      <view class="sheet__inner">
        <view class="title">摘要</view>
        <view style="height: 10px;"></view>
        <view class="body" style="color: var(--text2);">{{content.raw_summary}}</view>
      </view>

      <view style="height: 84px;"></view>
    </view>
  </view>

  <view wx:if="{{content}}" class="bottom-cta">
    <view class="btn btn--primary bottom-cta__inner" bindtap="goRedirect">
      <text>查看全文</text>
    </view>
  </view>
</view>
