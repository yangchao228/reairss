<view class="page {{themeClass}}">
  <topbar title="找源" nav="{{nav}}"></topbar>

  <view class="sheet">
    <view class="sheet__inner">
      <view class="searchbox">
        <input
          class="searchbox__input"
          placeholder="搜索 RSS 源"
          placeholder-class="searchbox__placeholder"
          value="{{q}}"
          bindinput="onSearchInput"
        />
      </view>
    </view>

    <view class="divider"></view>

    <view class="sheet__inner--tight">
      <scroll-view scroll-x show-scrollbar="{{false}}">
        <view class="chip-row">
          <chip
            wx:for="{{categories}}"
            wx:key="value"
            text="{{item.label}}"
            value="{{item.value}}"
            selected="{{item.value === category}}"
            bind:change="onCategoryChange"
          />
        </view>
      </scroll-view>
    </view>

    <view class="divider"></view>

    <empty-state wx:if="{{showEmpty}}" title="没有找到匹配的源" desc="换个关键词或分类试试。" />

    <view wx:else class="list">
      <source-item
        wx:for="{{filtered}}"
        wx:key="id"
        source="{{item}}"
        subscribed="{{item.subscribed}}"
        bind:tapitem="onRowTap"
        bind:toggle="onToggleSubscribe"
      />
    </view>
  </view>
</view>
