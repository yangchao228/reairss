.searchbox {
  padding: 10px 12px;
  border-radius: 12px;
  background: rgba(0, 0, 0, 0.03);
  border: 1px solid var(--divider);
}

.theme-dark .searchbox {
  background: rgba(255, 255, 255, 0.05);
}

.searchbox__input {
  height: 24px;
  font-size: 14px;
  line-height: 20px;
  color: var(--text);
}

.searchbox__placeholder {
  color: var(--text2);
}
