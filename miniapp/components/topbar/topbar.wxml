<view class="topbar">
  <view class="topbar__status" style="height: {{nav.statusBarHeight}}px;"></view>
  <view class="topbar__inner" style="height: {{nav.navBarHeight}}px;">
    <view class="topbar__left" wx:if="{{showBack}}" bindtap="onBackTap">
      <text class="topbar__back">‹</text>
    </view>
    <view class="topbar__left topbar__left--empty" wx:else></view>

    <view class="topbar__center">
      <text class="h1 line1">{{title}}</text>
    </view>

    <view class="topbar__right" wx:if="{{rightText}}" bindtap="onRightTap">
      <text class="meta">{{rightText}}</text>
    </view>
    <view class="topbar__right" wx:else></view>
  </view>
  <view class="divider"></view>
</view>
