{
  "name": "Notion Minimal",
  "principles": [
    "极简排版，低噪音低层级",
    "无阴影，用分割线与留白建立层级",
    "整行可点，降低操作门槛",
    "适合长时间阅读（字号/行高/对比度克制）"
  ],
  "color": {
    "light": {
      "bg": "#F7F7F5",
      "surface": "#FFFFFF",
      "text": "#191919",
      "text2": "#6B6B6B",
      "divider": "#ECECEA",
      "border": "#E6E6E3",
      "primary": "#2F80ED",
      "danger": "#E5484D",
      "press": "rgba(0,0,0,0.035)"
    },
    "dark": {
      "bg": "#0F0F0F",
      "surface": "#171717",
      "text": "#EDEDED",
      "text2": "#A3A3A3",
      "divider": "#242424",
      "border": "#2A2A2A",
      "primary": "#60A5FA",
      "danger": "#FB7185",
      "press": "rgba(255,255,255,0.07)"
    }
  },
  "typography": {
    "pageTitle": { "size": 18, "lineHeight": 24, "weight": 600 },
    "listTitle": { "size": 18, "lineHeight": 26, "weight": 600 },
    "body": { "size": 14, "lineHeight": 20, "weight": 400 },
    "meta": { "size": 12, "lineHeight": 16, "weight": 400 }
  },
  "spacing": {
    "pagePaddingX": 16,
    "sectionPaddingY": 14,
    "gap8": 8,
    "gap12": 12,
    "gap16": 16,
    "gap24": 24
  },
  "radius": {
    "button": 12,
    "chip": 999,
    "search": 12
  },
  "component": {
    "minTapHeight": 44,
    "listItemPaddingY": 18,
    "listItemPaddingX": 16
  }
}
